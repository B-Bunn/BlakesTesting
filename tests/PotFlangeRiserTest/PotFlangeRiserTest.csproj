<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit-free check of the Pot Flange Riser rules: what counts as a toilet's pipe, the per-level longest, the formatting. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\BlakesTesting\Risers\PotFlangeRiserRules.cs" Link="PotFlangeRiserRules.cs" />
    <Compile Include="..\..\src\BlakesTesting\Risers\CutLengthRules.cs" Link="CutLengthRules.cs" />
  </ItemGroup>
</Project>
